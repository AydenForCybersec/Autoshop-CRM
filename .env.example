FLASK_ENV=development
FLASK_APP=autoshop_crm:create_app
PYTHONPATH=src
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=5000

DATABASE_URL=mysql+mysqlconnector://autoshop_user:your_db_password@localhost/autoshop

LOG_FILE=logs/app.log

# Production session/cookie hardening
SESSION_COOKIE_SECURE=true
REMEMBER_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https
MAX_CONTENT_LENGTH=8388608

# Optional in-app updater settings (recommended to keep false unless needed)
UPDATE_ENABLED=false
UPDATE_LOCAL_ONLY=true
UPDATE_CONFIRM_PHRASE=CONFIRM
UPDATE_ALLOWED_COMMAND_PREFIXES=./scripts/deploy_from_github.sh
UPDATE_POST_UPDATE_COMMANDS=./scripts/deploy_from_github.sh --skip-pull
